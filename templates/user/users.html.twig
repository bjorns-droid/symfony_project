{% extends 'base.html.twig' %}

{% block body %}
    <br>
    <h3>Liste aller User</h3>
    <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'ID', 'p.id') }}</th>
                <th{% if pagination.isSorted(['p.email']) %} class="sorted"{% endif %}>
                {{ knp_pagination_sortable(pagination, 'Email', ['p.email']) }}</th>
                <th{% if pagination.isSorted('p.name') %} class="sorted"{% endif %}>
                {{ knp_pagination_sortable(pagination, 'Name', 'p.name') }}</th>
                <th{% if pagination.isSorted('p.plz') %} class="sorted"{% endif %}>
                {{ knp_pagination_sortable(pagination, 'PLZ', 'p.plz') }}</th>
                <th{% if pagination.isSorted('p.ort') %} class="sorted"{% endif %}>
                {{ knp_pagination_sortable(pagination, 'Ort', 'p.ort') }}</th>
                <th{% if pagination.isSorted('p.telefon') %} class="sorted"{% endif %}>
                {{ knp_pagination_sortable(pagination, 'Telefon', 'p.telefon') }}</th>
            </tr>
        </thead>
        <tbody>
            {%for user in pagination %}
            <tr>
                <td>{{ user.id }}</td>
                <td><a href="{{ path('user.show', {id: user.id}) }}">{{ user.email }}</a></td>
                <td>{{ user.name }}</td>
                <td>{{ user.plz }}</td>
                <td>{{ user.ort }}</td>
                <td>{{ user.telefon }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table><br>
    <div class="navigation">
        {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
    </div>
{% endblock %}
